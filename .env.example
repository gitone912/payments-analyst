# Copy this file to .env (same folder) and fill in your key. .env is never committed.
#   Windows:  copy .env.example .env      macOS/Linux:  cp .env.example .env

# Turn on the LLM planner (leave empty to use the deterministic planner only)
LLM_PROVIDER=gemini
GEMINI_API_KEY=paste-your-key-here

# Optional
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_FALLBACK_MODELS=gemini-3.1-flash-lite
# LLM_MIN_INTERVAL_S=4.5        # pace requests on a free-tier key (15 requests/minute)
